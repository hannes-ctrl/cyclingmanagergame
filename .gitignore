# Third-party game data: not ours to redistribute, and 23 GB
/worlddb/

# Derived from the WorldDB or fetched from the web; rebuilt by the tools
/data/world.sqlite
/data/jerseys/
/data/kits/
/data/pcs_cache/
/data/*.log

# Save games
/data/saves/
/data/savegame.json

# Build output
/native/build/
.dart_tool/
build/
*.iml

# Screens rendered by the tests; they differ on every run
/app/test/goldens/
/app/test/failures/

# Clone of https://github.com/zao/ooz (commit ff5aeb9), see native/build_ooz.sh
/third_party/ooz/
/data/logos/
/data/settings.json

# Real results fetched from ProCyclingStats (packages/calibration/bin/fetch_results.dart)
/data/results/

# Output of calibration runs; the tuning values themselves are tracked
/data/calibration/log.txt
/data/calibration/report*.txt
/data/calibration/tuning_*.json

# Machine-specific toolchain paths
/env.local.ps1
/data/photos/

# Route weights for the season planner, derived from world.sqlite
/data/route_fit.cache.json

# Left behind by an interrupted test run
/data/savegame_test*.json

# Written by the player: exported lists and what he set on the screens
/data/export/
/data/ui_state.json

# Release zips (release.ps1)
/dist/

# Races exported for developing the 3D viewer (packages/sim: dart run bin/sim.dart viewer)
/viewer/samples/
# Godot caches and exports
/viewer/.godot/
/viewer/build/
/viewer/override.cfg
